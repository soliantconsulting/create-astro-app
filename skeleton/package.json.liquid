{
    "name": "{{project.name}}",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "astro dev",
        {%- if contactForm %}
        "dev:contact": "tsx watch functions/dev-server.ts",
        {%- endif %}
        "build": "astro build && tsx ./scripts/seo-check.ts",
        "preview": "astro preview",
        "typecheck": "astro check",
        {%- if contactForm %}
        "test": "tsx --test \"test/**/*.test.ts\"",
        {%- endif %}
        "format": "biome format . --write",
        "check": "biome check . --write"
    },
    "dependencies": {
        "@astrojs/react": "^7.0.1",
        "@emotion/cache": "^11.14.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@mui/icons-material": "^9.2.0",
        "@mui/material": "^9.2.0",
        {%- if sentry %}
        "@sentry/astro": "^10.69.0",
        {%- endif %}
        "astro": "^7.3.8",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "sharp": "^0.35.5",
        "temporal-polyfill": "^1.0.5"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        {%- if contactForm %}
        "@aws-sdk/client-s3": "^3.1148.0",
        "@aws-sdk/client-secrets-manager": "^3.1148.0",
        "@aws-sdk/client-sesv2": "^3.1148.0",
        "@aws-sdk/client-sqs": "^3.1148.0",
        {%- endif %}
        "@biomejs/biome": "2.5.6",
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        {%- if contactForm and sentry %}
        "@sentry/aws-serverless": "^10.69.0",
        {%- endif %}
        {%- if contactForm %}
        "@types/aws-lambda": "^8.10.164",
        {%- endif %}
        "@types/node": "^26.1.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        {%- if contactForm %}
        "esbuild": "^0.28.2",
        {%- endif %}
        "lefthook": "^2.1.10",
        {%- if contactForm %}
        "ts-pattern": "^5.9.0",
        {%- endif %}
        "tsx": "^4.23.2",
        "typescript": "^6.0.3"{% if contactForm %},
        "zod": "^4.3.6"{% endif %}
    }
}
