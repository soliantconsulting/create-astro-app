import * as Sentry from "@sentry/astro";

// Pages ship no JavaScript by default, so on a site without islands this SDK is the only script
// a visitor downloads. Tracing is off; turn it on per site with a measured sample rate.
Sentry.init({
    dsn: "{{sentry.dsn}}",
    environment: import.meta.env.PUBLIC_SENTRY_ENVIRONMENT ?? import.meta.env.MODE,
    tracesSampleRate: 0,
});
