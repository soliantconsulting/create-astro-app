/**
 * The single source of truth for every indexable URL on this site.
 *
 * Titles, descriptions, navigation and the sitemap all read from this one array. That is
 * deliberate: the failure this starter exists to prevent is a site that ships hundreds of pages
 * all carrying the same template-default title, which is what a real audit of a legacy client
 * catalog found. A page cannot set its own title, because BaseLayout resolves it from here by
 * path. Adding a page without registering it fails the build (see scripts/seo-check.ts).
 */

export const SITE_URL = "https://{{stagingDomain.domainName | default: 'example.com'}}";

export type ChangeFreq = "always" | "hourly" | "daily" | "weekly" | "monthly" | "yearly" | "never";

export type RouteSeo = {
    /** Path as served, always with a leading and trailing slash except the root. */
    path: string;
    /** Full <title>. Written per page. Must be unique across the site. */
    title: string;
    /** Meta description. Written per page. Must be unique across the site. */
    description: string;
    /** Label in the primary navigation. Omit to keep the page out of the nav. */
    navLabel?: string;
    /** Parent path, for breadcrumbs and nested nav. */
    parent?: string;
    /**
     * False emits noindex and excludes the page from the sitemap. Use for search results,
     * facet permutations, thank-you pages and anything gated.
     */
    indexable: boolean;
    changefreq?: ChangeFreq;
    priority?: number;
};

export const routes: RouteSeo[] = [
    {
        path: "/",
        title: "{{project.title}}",
        description: "{{project.title}} home page.",
        navLabel: "Home",
        indexable: true,
        changefreq: "monthly",
        priority: 1,
    },
    {
        path: "/about/",
        title: "About | {{project.title}}",
        description: "About {{project.title}}.",
        navLabel: "About",
        indexable: true,
        changefreq: "yearly",
        priority: 0.8,
    },
    {%- if features contains "contact-form" %}
    {
        path: "/contact/",
        title: "Contact | {{project.title}}",
        description: "Contact {{project.title}}.",
        navLabel: "Contact",
        indexable: true,
        changefreq: "yearly",
        priority: 0.8,
    },
    {
        path: "/thank-you/",
        title: "Thank you | {{project.title}}",
        description: "Submission received.",
        indexable: false,
    },
    {%- endif %}
];

const routesByPath = new Map(routes.map((route) => [route.path, route]));

export const getRoute = (path: string): RouteSeo => {
    const route = routesByPath.get(path);

    if (!route) {
        throw new Error(
            `No route registered for "${path}". Add it to src/seo/routes.ts. Every page must be ` +
                "registered so its title, description and sitemap entry come from one place.",
        );
    }

    return route;
};

export const navRoutes = (): RouteSeo[] => routes.filter((route) => route.navLabel !== undefined);

export const indexableRoutes = (): RouteSeo[] => routes.filter((route) => route.indexable);

export const canonicalUrl = (path: string): string => new URL(path, SITE_URL).href;

export const breadcrumbTrail = (path: string): RouteSeo[] => {
    const trail: RouteSeo[] = [];
    let current: RouteSeo | undefined = getRoute(path);

    while (current) {
        trail.unshift(current);
        current = current.parent ? routesByPath.get(current.parent) : undefined;
    }

    return trail;
};
