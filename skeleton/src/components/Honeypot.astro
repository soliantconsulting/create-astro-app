---
/**
 * A field a bot fills and a person never sees.
 *
 * aria-hidden and tabindex="-1" keep it out of the accessibility tree and the tab order. Without
 * them a screen reader user can tab into it, fill it in, and have their submission discarded.
 * Moved off-canvas rather than display:none because some bots skip hidden fields.
 */
import { HONEYPOT_FIELD } from "../forms/contact-forms.js";
---

<div aria-hidden="true" class="honeypot">
    <label for={HONEYPOT_FIELD}>Leave this field empty</label>
    <input id={HONEYPOT_FIELD} name={HONEYPOT_FIELD} type="text" tabindex="-1" autocomplete="off" />
</div>

<style>
    .honeypot {
        position: absolute;
        left: -9999px;
        width: 1px;
        height: 1px;
        overflow: hidden;
    }
</style>
