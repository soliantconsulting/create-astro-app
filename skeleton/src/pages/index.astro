---
import Button from "../components/Button.astro";
import ButtonRow from "../components/ButtonRow.astro";
import Layout from "../layouts/Layout.astro";
import { siteName } from "../site.js";
---

<Layout path="/">
    <section class="container section">
        <h1>{siteName}</h1>
        <p class="reading-width">
            This site was generated by the Soliant Create Astro App starter. Its title and
            description come from the "/" entry in src/seo/routes.ts.
        </p>
        <ButtonRow>
            <Button href="/about/">About us</Button>
        </ButtonRow>
    </section>
</Layout>
