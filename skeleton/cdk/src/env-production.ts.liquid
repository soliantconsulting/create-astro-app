import { App } from "aws-cdk-lib";
import { AppStack } from "./app-stack.js";

const app = new App();

new AppStack(app, "{{project.name}}-production", {
    env: {
        account: "{{awsEnv.accountId}}",
        region: "{{awsEnv.region}}",
    },
    // Fill both in once the production certificate is issued and the domain is confirmed.
    certificateArn: "CHANGE-ME",
    domainName: "CHANGE-ME",
    buildEnv: {
        {%- if sentry %}
        SENTRY_ENVIRONMENT: "production",
        {%- endif %}
        {%- if features contains "contact-form" %}
        PUBLIC_RECAPTCHA_SITE_KEY: "",
        {%- endif %}
    },
});

app.synth();
