import { execSync } from "node:child_process";
import { existsSync, readdirSync } from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { AssetHashType, CfnOutput, Duration, DockerImage, RemovalPolicy, Size, Stack, type StackProps } from "aws-cdk-lib";
import { Certificate } from "aws-cdk-lib/aws-certificatemanager";
import {
    CachePolicy,
    Distribution,
    Function as CloudFrontFunction,
    FunctionCode,
    FunctionEventType,
    HttpVersion,
    ResponseHeadersPolicy,
    ViewerProtocolPolicy,
} from "aws-cdk-lib/aws-cloudfront";
import { S3BucketOrigin } from "aws-cdk-lib/aws-cloudfront-origins";
import { LogGroup, RetentionDays } from "aws-cdk-lib/aws-logs";
import { BlockPublicAccess, Bucket } from "aws-cdk-lib/aws-s3";
import { BucketDeployment, CacheControl, Source } from "aws-cdk-lib/aws-s3-deployment";
import type { Construct } from "constructs";
import { copySync } from "fs-extra/esm";

type BuildEnv = Record<string, string>;

type AppStackProps = StackProps & {
    certificateArn: string;
    domainName: string;
    buildEnv: BuildEnv;
};

export class AppStack extends Stack {
    public constructor(scope: Construct, id: string, props: AppStackProps) {
        super(scope, id, props);

        const websiteBucket = new Bucket(this, "WebsiteBucket", {
            autoDeleteObjects: true,
            blockPublicAccess: BlockPublicAccess.BLOCK_ALL,
            removalPolicy: RemovalPolicy.DESTROY,
        });

        const certificate = Certificate.fromCertificateArn(
            this,
            "Certificate",
            props.certificateArn,
        );

        /*
         * Astro is built with `format: "directory"`, so /about/ is stored as /about/index.html.
         * S3 behind Origin Access Control does no directory-index resolution, so without this
         * function every clean URL 404s. Appending index.html at the viewer edge is cheaper than
         * a Lambda@Edge and runs on every request for well under a millisecond.
         */
        const directoryIndex = new CloudFrontFunction(this, "DirectoryIndex", {
            code: FunctionCode.fromInline(`
function handler(event) {
    var request = event.request;
    var uri = request.uri;

    if (uri.endsWith("/")) {
        request.uri = uri + "index.html";
    } else if (!uri.includes(".")) {
        request.uri = uri + "/index.html";
    }

    return request;
}
`),
        });

        /*
         * Hashed assets are the only thing safe to mark immutable. Astro emits them under
         * /_astro/ with a content hash in the filename, so a changed file is a changed URL.
         * Everything else is regenerated on every build and must revalidate.
         *
         * The header the browser sees is set here, per cache behavior, rather than as S3 object
         * metadata. That keeps object metadata uniform, which in turn allows a single
         * BucketDeployment, which is what makes `prune` safe below.
         */
        const immutableAssetHeaders = new ResponseHeadersPolicy(this, "ImmutableAssetHeaders", {
            customHeadersBehavior: {
                customHeaders: [
                    {
                        header: "Cache-Control",
                        value: "public, max-age=31536000, immutable",
                        override: true,
                    },
                ],
            },
            securityHeadersBehavior: {
                strictTransportSecurity: {
                    accessControlMaxAge: Duration.days(365),
                    includeSubdomains: true,
                    override: true,
                },
            },
        });

        const documentHeaders = new ResponseHeadersPolicy(this, "DocumentHeaders", {
            customHeadersBehavior: {
                customHeaders: [
                    {
                        header: "Cache-Control",
                        value: "public, max-age=0, must-revalidate",
                        override: true,
                    },
                ],
            },
            securityHeadersBehavior: {
                strictTransportSecurity: {
                    accessControlMaxAge: Duration.days(365),
                    includeSubdomains: true,
                    override: true,
                },
                contentTypeOptions: { override: true },
                frameOptions: { frameOption: "DENY", override: true } as never,
                referrerPolicy: {
                    referrerPolicy: "strict-origin-when-cross-origin",
                    override: true,
                } as never,
            },
        });

        const origin = S3BucketOrigin.withOriginAccessControl(websiteBucket);

        const distribution = new Distribution(this, "Distribution", {
            certificate,
            domainNames: [props.domainName],
            defaultBehavior: {
                origin,
                cachePolicy: CachePolicy.CACHING_OPTIMIZED,
                responseHeadersPolicy: documentHeaders,
                viewerProtocolPolicy: ViewerProtocolPolicy.REDIRECT_TO_HTTPS,
                functionAssociations: [
                    {
                        function: directoryIndex,
                        eventType: FunctionEventType.VIEWER_REQUEST,
                    },
                ],
            },
            additionalBehaviors: {
                "/_astro/*": {
                    origin,
                    cachePolicy: CachePolicy.CACHING_OPTIMIZED,
                    responseHeadersPolicy: immutableAssetHeaders,
                    viewerProtocolPolicy: ViewerProtocolPolicy.REDIRECT_TO_HTTPS,
                },
            },
            defaultRootObject: "index.html",
            httpVersion: HttpVersion.HTTP2_AND_3,
            /*
             * A missing page returns a real 404 carrying the styled 404 document.
             *
             * The SPA starter maps both 404 and 403 to /index.html at HTTP 200. On a multi-page
             * site that is a soft-404 machine: every dead URL answers "200 OK" with the homepage,
             * so crawlers index unlimited duplicate homepages and monitoring reports the site as
             * healthy. 403 is included because S3 with Origin Access Control answers a missing
             * key with AccessDenied, not NoSuchKey.
             */
            errorResponses: [
                {
                    httpStatus: 404,
                    responseHttpStatus: 404,
                    responsePagePath: "/404.html",
                    ttl: Duration.minutes(1),
                },
                {
                    httpStatus: 403,
                    responseHttpStatus: 404,
                    responsePagePath: "/404.html",
                    ttl: Duration.minutes(1),
                },
            ],
        });

        // sld-dns-control resolves the CNAME target by finding a stack output whose key ends with
        // this exact name. Renaming it silently breaks `point-staging-domain`.
        new CfnOutput(this, "DistributionDomainName", { value: distribution.domainName });

        const sourcePath = fileURLToPath(new URL("../../", import.meta.url));
        const source = Source.asset(sourcePath, {
            exclude: ["cdk", "node_modules", ".astro"],
            bundling: {
                image: DockerImage.fromRegistry("public.ecr.aws/docker/library/alpine:latest"),
                command: ["sh", "-c", 'echo "Docker build not supported." && exit 1'],
                local: {
                    tryBundle: (outputDir: string): boolean => {
                        execSync("pnpm build", {
                            stdio: ["ignore", process.stderr, process.stdout],
                            cwd: sourcePath,
                            env: {
                                ...process.env,
                                ...props.buildEnv,
                            },
                        });

                        const distPath = path.join(sourcePath, "dist");

                        /*
                         * Assert the build actually produced a site before anything is synced.
                         *
                         * This guard and `prune` below ship together and must never be separated.
                         * Pruning means the sync deletes whatever is in the bucket and not in this
                         * directory, so a build that fails quietly and leaves an empty output
                         * would delete the live site. Throwing here is deliberate: returning false
                         * would fall through to the Docker path and report a confusing error.
                         */
                        if (!existsSync(distPath)) {
                            throw new Error("Build produced no dist directory.");
                        }

                        if (!existsSync(path.join(distPath, "404.html"))) {
                            throw new Error(
                                "Build produced no 404.html. The distribution serves it for every unknown URL, so deploying without it would return an empty body on 404.",
                            );
                        }

                        const entries = readdirSync(distPath);

                        if (!entries.includes("index.html")) {
                            throw new Error("Build produced no index.html at the root of dist.");
                        }

                        copySync(distPath, outputDir);

                        return true;
                    },
                },
                environment: props.buildEnv,
            },
            /*
             * OUTPUT rather than SOURCE because the source directory includes the whole project.
             * The cost is that any content change re-uploads the bundle to the CDK staging bucket;
             * the S3 sync itself is still incremental, so only changed objects reach the website
             * bucket.
             */
            assetHashType: AssetHashType.OUTPUT,
        });

        const deploymentLogGroup = new LogGroup(this, "DeploymentLogGroup", {
            retention: RetentionDays.ONE_WEEK,
        });

        new BucketDeployment(this, "BucketDeployment", {
            destinationBucket: websiteBucket,
            logGroup: deploymentLogGroup,
            /*
             * Retired pages are deleted rather than left to be served forever. The SPA starter
             * sets this to false, which is why a page removed from a site keeps answering 200
             * indefinitely.
             *
             * Safe only because tryBundle above refuses to hand over an empty or partial build.
             */
            prune: true,
            cacheControl: [CacheControl.fromString("public, max-age=0, must-revalidate")],
            sources: [source],
            /*
             * One invalidation of /* per deploy. Per-file invalidation looks cheaper and is not:
             * the first 1,000 paths a month are free and every path after that is billed, so a
             * catalog-sized site invalidating per file runs to real money per deploy.
             */
            distribution,
            distributionPaths: ["/*"],
            // The pipeline does not need to sit and watch the invalidation finish.
            waitForDistributionInvalidation: false,
            memoryLimit: 1024,
            // The deployment Lambda unzips the whole site into /tmp. 512 MiB is not enough once a
            // site has real images.
            ephemeralStorageSize: Size.gibibytes(2),
        });
    }
}
