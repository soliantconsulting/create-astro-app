{
    "extends": ["astro/tsconfigs/strict"],
    "compilerOptions": {
        "noImplicitAny": true,
        "types": ["node"],
        "jsx": "react-jsx",
        "jsxImportSource": "react"
    },
    "include": [
        ".astro/types.d.ts",
        "src/**/*",
        "scripts/**/*",
        {%- if contactForm %}
        "functions/**/*",
        "test/**/*",
        {%- endif %}
        "astro.config.mjs"
    ],
    "exclude": ["dist", "cdk"]
}
